{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/valida-frontmatter.mjs\"",
            "timeout": 15,
            "statusMessage": "Validando frontmatter de agents, commands e skills..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/check-on-stop.mjs\"",
            "timeout": 180,
            "statusMessage": "Rodando lint e typecheck..."
          }
        ]
      }
    ]
  }
}
